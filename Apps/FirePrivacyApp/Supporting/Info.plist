<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>Fire Privacy</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>UILaunchScreen</key>
    <dict/>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <!-- The initial release requests no protected-resource permission at all
         (ONB-004). Local network access is listed only because a user who sets
         up their own model endpoint invokes it explicitly; the string states
         exactly that. -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>Fire Privacy asks for this only if you choose to connect to a language-model server you run on your own network. It is never used otherwise.</string>
</dict>
</plist>
