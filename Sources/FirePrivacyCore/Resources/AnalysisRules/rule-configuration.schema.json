                "type": "boolean"
              },
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "minimumDistinctDestinations",
                  "maximumReviewedCoverage"
                ],
                "properties": {
                  "minimumDistinctDestinations": {
                    "type": "integer",
                    "minimum": 10,
                    "maximum": 1000
                  },
                  "maximumReviewedCoverage": {
                    "type": "number",
                    "minimum": 0.05,
                    "maximum": 0.5
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "enabled",
              "parameters"
            ],
            "properties": {
              "id": {
                "const": "VENDOR-KNOWN-006"
