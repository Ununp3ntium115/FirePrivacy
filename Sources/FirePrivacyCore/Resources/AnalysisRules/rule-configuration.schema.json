              "id",
              "enabled",
              "parameters"
            ],
            "properties": {
              "id": {
                "const": "AGG-CROSSAPP-002"
              },
              "enabled": {
                "type": "boolean"
              },
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "minimumDistinctApps"
                ],
                "properties": {
                  "minimumDistinctApps": {
                    "type": "integer",
                    "minimum": 3,
                    "maximum": 1000
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
