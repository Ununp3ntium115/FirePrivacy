              },
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "required": [],
                "properties": {}
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "enabled",
              "parameters"
            ],
            "properties": {
              "id": {
                "const": "UNKNOWN-HIGHFANOUT-005"
              },
